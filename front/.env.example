# Backend API URL (include protocol, no trailing slash)
VITE_API_URL=http://localhost:5000

# Google OAuth client ID (public, safe to expose)
VITE_GOOGLE_CLIENT_ID=

# Telegram bot username (for deep link registration)
VITE_TELEGRAM_BOT_USERNAME=gamesofsenses_bot

# Optional: custom logo image URL
VITE_LOGO_URL=

# Sentry error tracking (production)
VITE_SENTRY_DSN_FRONTEND=

# NOTE: Never add VITE_GOOGLE_CLIENT_SECRET here.
# The OAuth client secret belongs only on the backend, never in a Vite frontend build.

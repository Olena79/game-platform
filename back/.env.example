NODE_ENV=development
PORT=5000

MONGO_URI=
# At least 32 random characters
JWT_SECRET=
# Frontend origin(s), comma-separated. The first one is used in password reset links.
CLIENT_URL=http://localhost:5173

LIVEKIT_URL=wss://game-platform-qxkv0ujg.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google sign-in. MUST equal the frontend's VITE_GOOGLE_CLIENT_ID: without it
# the ID token audience is never checked and tokens issued to any other Google
# app are accepted. The server refuses to start if it is missing.
GOOGLE_CLIENT_ID=

# Language used for bot messages when the account has no preference
DEFAULT_LANGUAGE=uk

# Error tracking (optional)
SENTRY_DSN_BACKEND=

# Game recordings live in this Cloudflare R2 bucket and are deleted after 7 days.
# R2 → Manage R2 API Tokens → "Object Read & Write" on this bucket.
# RECORDING_MODE: "browser" (default, free) — the gamemaster's browser records
# and uploads; "egress" — LiveKit records on its servers (needs a paid LiveKit
# plan: the free one allows 60 minutes a month).
RECORDING_MODE=browser
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_OPTIONS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Set to "off" on a second instance (local dev) so it does not steal the bot
TELEGRAM_POLLING=

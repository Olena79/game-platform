NODE_ENV=development
PORT=5000

MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://localhost:3000
# CLIENT_URL=https://game-platform-red.vercel.app


EMAIL_ENABLED=true

# Email Provider — choose ONE:
# Option 1: SendGrid (recommended for production)
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@yourdomain.com

# Option 2: Brevo Web API (recommended for Render/cloud hosting)
BREVO_API_KEY=

LIVEKIT_URL=wss://game-platform-qxkv0ujg.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Drive (for recordings)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: folder ID in Google Drive to store recordings (leave blank for root)
GOOGLE_DRIVE_FOLDER_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_OPTIONS=--dns-result-order=ipv4first
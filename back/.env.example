NODE_ENV=development
PORT=5000

MONGO_URI=
JWT_SECRET=
CLIENT_URL=https://localhost:3000

LIVEKIT_URL=wss://game-platform-qxkv0ujg.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Drive (for recordings)
# Preferred: OAuth as the account that should own the recordings. A service
# account has no Drive storage of its own, so outside Google Workspace every
# upload fails with storageQuotaExceeded.
# Get the refresh token once with: node --env-file=.env scripts/get-drive-token.js
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Fallback, only usable when the target folder is in a Shared Drive (Workspace)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: folder ID for recordings. Left blank, the app keeps its own folder.
GOOGLE_DRIVE_FOLDER_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_OPTIONS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Set to "off" on a second instance (local dev) so it does not steal the bot
TELEGRAM_POLLING=
